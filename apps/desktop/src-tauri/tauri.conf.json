{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDX",
  "mainBinaryName": "mdx",
  "version": "0.4.0",
  "identifier": "io.github.getaxtools.mdx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDX - Markdown Explorer",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://mdx-image.localhost mdx-image:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://mdx-image.localhost mdx-image:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "getaxtools",
    "copyright": "Copyright (c) 2026 getaxtools",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/getaxtools/mdx",
    "category": "Productivity",
    "shortDescription": "A fast, private Markdown viewer",
    "longDescription": "MDX - Markdown Explorer is a fast, private Markdown viewer. It collects no data and makes no network connections.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
